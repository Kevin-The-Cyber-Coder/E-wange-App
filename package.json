{
  "name": "e-wange",
  "version": "1.0.0",
  "private": true,
  "description": "E-Wange smart home platform — React + Vite frontend, Node/Express + MongoDB backend",
  "scripts": {
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "db:seed": "cd backend && npm run seed",
    "db:seeds": "cd backend && npm run seeds",
    "db:reset": "cd backend && npm run reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
