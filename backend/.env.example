# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/e-wange

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS (comma separated list of allowed origins)
CLIENT_ORIGIN=http://localhost:8080

# Chat assistant (optional, OpenAI-compatible provider)
# The assistant runs commands and answers sensor questions without a key;
# set AI_API_KEY to also answer open-ended questions with an LLM.
# OpenRouter example: AI_API_BASE=https://openrouter.ai/api/v1 and
# AI_MODEL=openai/gpt-4o-mini (or any model from openrouter.ai/models).
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
